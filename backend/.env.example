# Express Server Configuration
PORT=3000

# MySQL Database Configuration (Aiven Cloud / Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=tastybite_db
DB_SSL=true # Set to true for Aiven or cloud MySQL SSL connections


# Supabase Storage Configuration
# Get these from your Supabase project: Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_BUCKET=recipe-images

# JWT Authentication Secret
JWT_SECRET=your-secret-here

# CORS Configuration (Optional: default allows all in development)
CORS_ORIGIN=http://localhost:5173


